# --- Option A (recommended): Next.js proxies /yah/* to the backend ---
# Leave NEXT_PUBLIC_API_BASE_URL unset; the client then calls /yah/api/v1 on the same origin.
API_PROXY_TARGET=http://localhost:8080

# --- Option B: the browser calls the backend directly (needs CORS on the backend) ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/yah/api/v1

NEXT_PUBLIC_MEMBERS_MOCK=true
